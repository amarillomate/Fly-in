start: _NEWLINE* count_drones (_NEWLINE+ statement)+ _NEWLINE*

count_drones: _NB_DRONES SIGNED_INT

statement: nodes | connections

nodes: _START_HUB HUB_NAME SIGNED_INT SIGNED_INT metadata? -> start_hub
     | _END_HUB HUB_NAME SIGNED_INT SIGNED_INT metadata? -> end_hub
     | _HUB HUB_NAME SIGNED_INT SIGNED_INT metadata? -> hub
metadata: "[" data+ "]"

data: color | zone | max_drones
color: "color=" COLOR_VALUE
zone: "zone=" CNAME
max_drones: "max_drones=" SIGNED_INT

connections: _CONNECTION NAME _DASH NAME c_metadata?
c_metadata: "[" c_data "]"
c_data: "max_link_capacity=" SIGNED_INT

_NB_DRONES: /nb_drones:(?=[ \t])/
_START_HUB: /start_hub:(?=[ \t])/
_END_HUB: /end_hub:(?=[ \t])/
_HUB: /hub:(?=[ \t])/
_CONNECTION: /connection:(?=[ \t])/

_DASH: /(?<=\S)-(?=\S)/
NAME: /[^\s\[\]#\-]+/
HUB_NAME: /[^\s\[\]#\-]+/
COLOR_VALUE: /[^\s=\[\]#]+/

%import common.CNAME
%import common.SIGNED_INT
%import common.NEWLINE -> _NEWLINE
%import common.WS_INLINE
%ignore WS_INLINE
%ignore /#[^\r\n]*/
